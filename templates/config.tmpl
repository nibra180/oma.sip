# baresip config generated by the oma.sip plugin
# Base: baresip 4.6 defaults, trimmed down for a bar softphone.

poll_method             epoll

# --- SIP ---
sip_cafile              /etc/ssl/certs/ca-certificates.crt
sip_capath              /etc/ssl/certs
# Validate the server certificate on TLS (accounts default to TLS+SRTP).
sip_verify_server       yes
# sip_listen is deliberately left unset. baresip then binds a SIP transport
# (UDP and TCP) on every local address with an OS-assigned port, which is what
# makes the phone reachable from whatever network the machine is in: Wi-Fi, a
# VPN interface, and every container bridge. Those listeners accept
# unauthenticated INVITEs, so anything on the same network can make the phone
# ring; call_accept no only stops the plugin from answering itself.
# To pin it down, set sip_listen to an address and port, which restricts the
# listener to the matching interface and gives you a fixed port to firewall:
#   sip_listen 192.168.1.5:5060   (breaks on a network change)
#   sip_transports udp,tcp,tls    (or only tls, if the PBX supports it)
call_local_timeout      120
# One call at a time: a second incoming call gets 486 Busy from baresip
# itself (the plugin does not manage multiple lines).
call_max_calls          1
call_accept             no

# --- Audio (PipeWire; device managed by the plugin's audio picker) ---
audio_player            pipewire
audio_source            pipewire
audio_alert             pipewire
audio_telev_pt          101

# --- RTP ---
rtp_tos                 184
audio_jitter_buffer_type        fixed
audio_jitter_buffer_ms  100-200

# --- Modules ---
module_path             /usr/lib/baresip/modules
module                  g711.so
module                  opus.so
module                  auconv.so
module                  auresamp.so
module                  pipewire.so
module                  webrtc_aec.so
module                  srtp.so
module                  uuid.so
module                  stun.so

module_app              account.so
module_app              contact.so
module_app              debug_cmd.so
module_app              menu.so
module_app              netroam.so
module_app              ctrl_dbus.so

# --- Local control ---
# ctrl_dbus: control over the per-user D-Bus SESSION bus. The bus socket
# lives in $XDG_RUNTIME_DIR (0700) and peers are kernel-authenticated
# (same UID only) — no TCP port is opened.
# Never load ctrl_tcp/httpd/cons/mqtt (all unauthenticated).
ctrl_dbus_use           session
