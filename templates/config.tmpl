# Config do baresip gerado pelo plugin oma.sip
# Base: default do baresip 4.6, enxugado para softfone de barra.

poll_method             epoll

# --- SIP ---
sip_cafile              /etc/ssl/certs/ca-certificates.crt
sip_capath              /etc/ssl/certs
call_local_timeout      120
call_max_calls          4
call_accept             no

# --- Áudio (PipeWire; dispositivo = default do sistema) ---
audio_player            pipewire
audio_source            pipewire
audio_alert             pipewire
audio_telev_pt          101

# --- RTP ---
rtp_tos                 184
audio_jitter_buffer_type        fixed
audio_jitter_buffer_ms  100-200

# --- Módulos ---
module_path             /usr/lib/baresip/modules
module                  g711.so
module                  opus.so
module                  auconv.so
module                  auresamp.so
module                  pipewire.so
module                  webrtc_aec.so
module                  srtp.so
module                  uuid.so
module                  stun.so

module_app              account.so
module_app              contact.so
module_app              debug_cmd.so
module_app              menu.so
module_app              netroam.so
module_app              ctrl_tcp.so

# --- Controle local ---
# ATENÇÃO: o ctrl_tcp NÃO tem autenticação. Manter SEMPRE em 127.0.0.1.
# Nunca carregar httpd/cons/mqtt (também sem auth).
ctrl_tcp_listen         127.0.0.1:4444
